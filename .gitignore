# ==========================================
# Git Ignore for FloatingMic (Python / Cython / PyInstaller)
# ==========================================

# Bytecode & Python Cache
__pycache__/
*.py[cod]
*$py.class

# Cython & C-Extension Binaries
*.pyd
*.c
*.so

# C/C++ Compiler Artifacts
*.obj
*.lib
*.exp
*.res

# PyInstaller & Build Outputs
build/
dist/

# Virtual Environments
.env
.venv
env/
venv/
ENV/

# IDE & Editor Settings
.vscode/
.idea/
.vs/
*.swp
*.swo

# Operating System Files
Thumbs.db
Desktop.ini
.DS_Store

# Logs & Temporary Files
*.log
*.tmp
*.bak

# Scripts containing API tokens / private utilities
up.py
SpeechFunc/SherpaONNX/up.py
